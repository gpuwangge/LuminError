#version 460
#extension GL_EXT_ray_tracing : require

hitAttributeEXT vec2 attribs;

void main()
{
    vec3 ro = gl_ObjectRayOriginEXT;
    vec3 rd = gl_ObjectRayDirectionEXT;

    float a = dot(rd, rd);
    float b = 2.0 * dot(ro, rd);
    float c = dot(ro, ro) - 1.0;

    float disc = b * b - 4.0 * a * c;
    if (disc < 0.0) return;

    float s = sqrt(disc);
    float inv2a = 0.5 / a;

    float t0 = (-b - s) * inv2a;
    float t1 = (-b + s) * inv2a;

    float t = -1.0;
    if (t0 >= gl_RayTminEXT && t0 <= gl_RayTmaxEXT) t = t0;
    else if (t1 >= gl_RayTminEXT && t1 <= gl_RayTmaxEXT) t = t1;

    if (t < 0.0) return;

    reportIntersectionEXT(t, 1);
}