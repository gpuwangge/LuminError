#version 460
//#extension GL_EXT_ray_tracing : require
#include "../CommonShaders/rayPipelineCommonStruct.glsl"

const int RAY_PER_PIXEL = 1;
const int BOUNCE_LIMIT  = 5;
const int MAX_PATHS = 8;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D resultImage;
layout(location = 0) rayPayloadEXT PrimaryPayload primaryPayload;
layout(set = 0, binding = 1) uniform accelerationStructureEXT topLevelAS;

layout(set = 0, binding = 6) uniform GlobalBufferObject {
    mat4 mainCameraView;
    mat4 mainCameraViewInverse;
    mat4 mainCameraProj;
    mat4 mainCameraProjInverse; 
    vec3 mainCameraPos;
    float tanHalfFovY;
    float aspect;
    float padding[58];
} globalUBO;

layout(set = 0, binding = 7) uniform CustomBufferObject {
    int frameCount;
    bool cameraInMotion;
    uint lightCount;
    uint materialCount;
} customUBO;

void main(){
    ivec2 pix  = ivec2(gl_LaunchIDEXT.xy);
    ivec2 size = ivec2(gl_LaunchSizeEXT.xy);

    vec3 accumulatedRadiance = vec3(0.0);

    for (int s = 0; s < RAY_PER_PIXEL; ++s)
    {
        vec2 jitter = rnd2(pix, s, customUBO.frameCount);
        vec2 uv = (vec2(pix) + jitter) / vec2(size);
        vec2 ndc = uv * 2.0 - 1.0;

        // 如有需要再开
        // ndc.y = -ndc.y;

        vec4 viewDirH = globalUBO.mainCameraProjInverse * vec4(ndc, 1.0, 1.0);
        vec3 rayDir = normalize(
            (globalUBO.mainCameraViewInverse * vec4(normalize(viewDirH.xyz), 0.0)).xyz
        );
        vec3 rayOrigin = globalUBO.mainCameraPos;

        vec3 lightColor = vec3(0.0);

        //const int MAX_PATHS = 8;
        PathState pathStack[MAX_PATHS];
        int stackSize = 0;

        pathStack[stackSize++] = PathState(
            rayOrigin,
            rayDir,
            vec3(1.0),
            1.0, //ior
            vec3(0.0),   // mediumEntryPos
            0u,           // insideMedium=0，假设一开始在空气里
            0u //depth
        );

        while(stackSize > 0){
            PathState path = pathStack[--stackSize];

            primaryPayload.radiance = vec3(0.0);
            primaryPayload.throughput = path.throughput;
            primaryPayload.spawnRayCount = 0u;
            primaryPayload.done = 0u;
            primaryPayload.currentIOR = path.currentIOR;
            primaryPayload.insideMedium = path.insideMedium;
            primaryPayload.mediumEntryPos = path.mediumEntryPos;

            traceRayEXT(
                topLevelAS,
                0, //gl_RayFlagsOpaqueEXT,
                0xFF,
                0, 1, 0,
                path.origin,
                EPSILON,
                path.direction,
                1e32,
                0
            );

            accumulatedRadiance += path.throughput * primaryPayload.radiance;

            if(path.depth + 1u >= BOUNCE_LIMIT) continue;

            if(primaryPayload.spawnRayCount >= 1u && stackSize < MAX_PATHS){
                PathState nextPath;
                nextPath.origin = primaryPayload.nextRayOrigin0;
                nextPath.direction = primaryPayload.nextRayDir0;
                nextPath.throughput = path.throughput * primaryPayload.nextRayThroughputMul0;
                nextPath.depth = path.depth + 1u;
                nextPath.currentIOR = primaryPayload.nextCurrentIOR0;
                nextPath.mediumEntryPos = primaryPayload.nextMediumEntryPos0;
                nextPath.insideMedium = primaryPayload.nextInsideMedium0;
                pathStack[stackSize++] = nextPath;
            }

            if(primaryPayload.spawnRayCount >= 2u && stackSize < MAX_PATHS){
                PathState secondPath;
                secondPath.origin = primaryPayload.nextRayOrigin1;
                secondPath.direction = primaryPayload.nextRayDir1;
                secondPath.throughput = path.throughput * primaryPayload.nextRayThroughputMul1;
                secondPath.depth = path.depth + 1u;
                secondPath.currentIOR = primaryPayload.nextCurrentIOR1;
                secondPath.mediumEntryPos = primaryPayload.nextMediumEntryPos1;
                secondPath.insideMedium = primaryPayload.nextInsideMedium1;
                pathStack[stackSize++] = secondPath;
            }
        }//stack


        // primaryPayload.throughput = vec3(1.0);
        // primaryPayload.radiance   = vec3(0.0);
        // primaryPayload.nextOrigin = rayOrigin;
        // primaryPayload.nextDir    = rayDir;
        // primaryPayload.done       = 0u;

        // for (int bounce = 0; bounce < BOUNCE_LIMIT; ++bounce)
        // {
        //     vec3 oldThroughput = primaryPayload.throughput;

        //     rayOrigin = primaryPayload.nextOrigin;
        //     rayDir    = normalize(primaryPayload.nextDir);

        //     primaryPayload.radiance = vec3(0.0);
        //     primaryPayload.done     = 1u;
        //     primaryPayload.depth = bounce;

        //     traceRayEXT(
        //         topLevelAS,
        //         gl_RayFlagsOpaqueEXT,
        //         0xFF,
        //         0,   // sbtRecordOffset
        //         1,   // sbtRecordStride，前提是你的 SBT 确实这样排
        //         0,   // missIndex
        //         rayOrigin,
        //         0.001,
        //         rayDir,
        //         10000.0,
        //         0
        //     );

        //     lightColor += oldThroughput * primaryPayload.radiance;
        //     //lightColor += primaryPayload.radiance;

        //     if (primaryPayload.done != 0u)
        //         break;

        //     if (max(primaryPayload.throughput.r,
        //             max(primaryPayload.throughput.g, primaryPayload.throughput.b)) < 0.001)
        //         break;
        // }

        //finalColor += lightColor;
    }//spp

    accumulatedRadiance /= float(RAY_PER_PIXEL);
    imageStore(resultImage, pix, vec4(accumulatedRadiance, 1.0).bgra);
}