#version 460
#extension GL_EXT_ray_tracing : require

#include "../CommonShaders/rayPipelineCommon.glsl"

const int RAY_PER_PIXEL = 4; //SPP, Sample per Pixel, TODO: add to uniform
const int BOUNCE_LIMIT = 1; //TODO: add to uniform
const int FRAME_INDEX = 1; //TODO: add to uniform

layout(set = 0, binding = 0, rgba8 ) uniform writeonly image2D resultImage;
layout(set = 0, binding = 1) uniform accelerationStructureEXT topLevelAS;
layout(location = 0) rayPayloadEXT PrimaryPayload primaryPayload;

void main() {
    ivec2 pix  = ivec2(gl_LaunchIDEXT.xy);
    ivec2 size = ivec2(gl_LaunchSizeEXT.xy);

    //vec2 uv = (vec2(pix) + 0.5) / vec2(size);
    //uv = uv * 2.0 - 1.0;
    //vec3 rayOrigin = vec3(0.0, -0.0, -7.0);
    //vec3 rayDir    = normalize(vec3(uv.x, -uv.y, 1.5));

    vec3 finalColor = vec3(0.0);

    for (int s = 0; s < RAY_PER_PIXEL; ++s) {
        vec2 jitter = rnd2(pix, s, FRAME_INDEX);
        vec2 uv = (vec2(pix) + jitter) / vec2(size);
        uv = uv * 2.0 - 1.0;
        vec3 rayOrigin = vec3(0.0, -0.0, -7.0);
        vec3 rayDir    = normalize(vec3(uv.x, -uv.y, 1.5));
        vec3 lightColor = vec3(0.0);

        //payload = vec3(0.0, 0.0, 0.0);//init payload
        primaryPayload.throughput = vec3(1.0);
        primaryPayload.done       = 0u;

        //反射/多次 bounce 更适合在 raygen 中循环，而不是在 hit shader 里递归，这样更快，也绕开较小的 recursion limit。
        for (int bounce = 0; bounce < BOUNCE_LIMIT; ++bounce) { 
            primaryPayload.radiance   = vec3(0.0);
            primaryPayload.nextOrigin = rayOrigin;
            primaryPayload.nextDir    = rayDir;

            traceRayEXT( //primary ray
                topLevelAS,
                gl_RayFlagsOpaqueEXT,
                0xff,
                0,   // sbtRecordOffset
                2,   // sbtRecordStride
                0,   // missIndex
                rayOrigin,
                0.001,
                rayDir,
                10000.0,
                0    // primary payload location
            );
            //Notes:
            //SBTRecordStride 的意思是：同一次 trace 里，SBT hit record 之间按“几组一跳”来索引。
            //它不是字节步长，而是“记录编号的步长”概念 。
            //SBT hit 区是按 primary / shadow 两个 record 成对排的，所以一条 ray 要跨过另一条 ray type 的 record，索引步长自然就是 2。

            lightColor += primaryPayload.throughput * primaryPayload.radiance;
            if(primaryPayload.done != 0u) break; //当当前这条路径已经不需要继续往下追踪时，直接退出 bounce 循环
        }

        finalColor += lightColor;
    }

    finalColor /= float(RAY_PER_PIXEL);

    //imageStore(resultImage, pix, vec4(primaryPayload, 1.0).bgra);
    imageStore(resultImage, pix, vec4(finalColor, 1.0));

}