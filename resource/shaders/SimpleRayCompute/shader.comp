#version 450

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalBufferObject {
    mat4 mainCameraView;
    mat4 mainCameraViewInverse;
    mat4 mainCameraProj;
    mat4 mainCameraProjInverse; 
    vec3 mainCameraPos;
    float tanHalfFovY;
    float aspect;
    float padding[58];
} globalUBO;

layout(set = 0, binding = 1, std430) readonly buffer SBOIn {
   vec4 pixels[];
} sboIn;

layout(set = 0, binding = 2, std430) buffer SBOOut {
   vec4 pixels[];
} sboOut;

layout (set = 0, binding = 3) uniform CustomBufferObject {
    int frameCount;
    //vec3 spherePos0;
    //vec3 spherePos1;
} customUBO;


layout (set = 0, binding = 4, rgba8 ) uniform writeonly image2D resultImage;

/***************************
* Constants
***************************/
const int BOUNCE_LIMIT = 10;
const int RAY_PER_PIXEL = 10;
const int NUM_SPHERES = 5;

/***************************
* Ray Tracing Data Structure
***************************/
struct Ray{
    vec3 origin;
    vec3 dir;
};

struct Material {
    vec3 albedo;
    float metallic;
    float roughness;
    float alpha;
    vec3 emissionColor;
    float emissionStrength;
    float reflectance;
    float specular;
    float ior;
    vec3 transmissionColor;
    float transmission;
};

struct Sphere{
    float radius;
    vec3 position;
    Material material;
};

Sphere spheres[NUM_SPHERES];

struct HitInfo{
    bool didHit;
    float dst;
    vec3 hitPoint;
    vec3 normal;
    Material material;
};

/***************************
* Ray Tracing Functions
***************************/
uint WangHash(inout uint seed) {
    seed = uint(seed ^ uint(61)) ^ uint(seed >> uint(16));
    seed *= uint(9);
    seed = seed ^ (seed >> 4);
    seed *= uint(0x27d4eb2d);
    seed = seed ^ (seed >> 15);
    return seed;
}

float Rand(inout uint state) {
    return float(WangHash(state)) / 4294967296.0;
}

vec3 RandomDirectionInHemisphere(vec3 normal, inout uint state){
    float u1 = Rand(state);
    float u2 = Rand(state);

    float r = sqrt(u1);
    float theta = 2.0 * 3.14159265359 * u2;
    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(1.0 - u1);

    vec3 tangent = normalize(abs(normal.x) > 0.1 ? cross(normal, vec3(0,1,0)) : cross(normal, vec3(1,0,0)));
    vec3 bitangent = cross(tangent, normal);

    vec3 direction = x * tangent + y * bitangent + z * normal;
    return normalize(direction);
}

HitInfo RaySphereHitCheck(Ray ray, Sphere sphere){
    HitInfo hitInfo;
    hitInfo.didHit = false;
    hitInfo.dst = -1.0;
    hitInfo.material.albedo = vec3(0.0);
    hitInfo.material.emissionColor = vec3(0.0);
    hitInfo.material.emissionStrength = 0;

    vec3 oc = ray.origin - sphere.position;
    float a = dot(ray.dir, ray.dir);
    float b = 2.0 * dot(oc, ray.dir);
    float c = dot(oc, oc) - sphere.radius * sphere.radius;
    float discriminant = b * b - 4.0 * a * c;

    if (discriminant < 0.0) {
        return hitInfo;
    }

    float sqrtDisc = sqrt(discriminant);
    float t1 = (-b - sqrtDisc) / (2.0 * a);
    float t2 = (-b + sqrtDisc) / (2.0 * a);
    float t = min(t1, t2);
    if (t < 0.001) t = max(t1, t2);
    
    
    if (t >= 0.001) {
        hitInfo.didHit = true;
        hitInfo.dst = t;
        hitInfo.hitPoint = ray.origin + ray.dir * t;
        hitInfo.normal = normalize(hitInfo.hitPoint - sphere.position);
        hitInfo.material = sphere.material;
    }

    return hitInfo;
}

HitInfo RaySpheresHitCheck(Ray ray){
    HitInfo hitInfo_closest;
    hitInfo_closest.didHit = false;
    hitInfo_closest.dst = -1.0;
    hitInfo_closest.material.albedo = vec3(0.7, 0.7, 0.7);
    hitInfo_closest.material.emissionStrength = 0;
    hitInfo_closest.material.emissionColor = vec3(0.0);
    for(int i = 0; i < NUM_SPHERES; i++){
        HitInfo hitInfo_current = RaySphereHitCheck(ray, spheres[i]);
        if(hitInfo_current.didHit && hitInfo_closest.didHit){ //current hit and previous hit
            if(hitInfo_current.dst < hitInfo_closest.dst) hitInfo_closest = hitInfo_current;
        }else if(hitInfo_current.didHit){ //current hit and no previous hit
            hitInfo_closest = hitInfo_current;
        }
    }
    return hitInfo_closest;
}

vec3 TraceRay(Ray ray, inout uint state){
    vec3 throughput = vec3(1.0);
    vec3 result_brightness_score = vec3(0.0);

    for(int i = 0; i < BOUNCE_LIMIT; i++) {
        HitInfo hitInfo = RaySpheresHitCheck(ray);
        if(!hitInfo.didHit) {
            result_brightness_score += vec3(0.2, 0.3, 0.4) * throughput;
            break;
        }

        Material mat = hitInfo.material;
        
        // 添加自发光贡献
        vec3 emittedLight = mat.emissionColor * mat.emissionStrength;
        result_brightness_score += emittedLight * throughput;

        // 俄罗斯轮盘赌（从第3次反弹开始）
        if(i > 2) {
            float p = max(throughput.r, max(throughput.g, throughput.b));
            if(p < 0.001) break;
            if(Rand(state) > p) break;
            throughput /= p;
        }

        // 计算基础反射率 F0
        vec3 F0 = mix(vec3(mat.reflectance), mat.albedo, mat.metallic);
        
        // 计算菲涅尔项
        float cosTheta = abs(dot(hitInfo.normal, -ray.dir));
        vec3 F = F0 + (1.0 - F0) * pow(1.0 - cosTheta, 5.0);
        
        // 处理折射/透射材质（玻璃、水等）
        if (mat.transmission > 0.0) {
            float refractionRatio = mat.ior;
            bool entering = dot(hitInfo.normal, -ray.dir) > 0.0;
            
            if (!entering) {
                hitInfo.normal = -hitInfo.normal;
                refractionRatio = 1.0 / mat.ior;
            }
            
            // 计算折射方向
            vec3 refractedDir = refract(ray.dir, hitInfo.normal, refractionRatio);
            
            float reflectionProbability = (F.r + F.g + F.b) / 3.0;
            
            // 对于玻璃，降低反射概率阈值，让更多光线折射
            if (length(refractedDir) < 0.001 || Rand(state) < reflectionProbability * 0.8) {
                // 反射
                ray.dir = reflect(ray.dir, hitInfo.normal);
                // 添加粗糙度影响
                if (mat.roughness > 0.0) {
                    ray.dir = normalize(mix(ray.dir, RandomDirectionInHemisphere(hitInfo.normal, state), mat.roughness));
                }
                throughput *= F / max(reflectionProbability, 0.1);
            } else {
                // 折射 - 玻璃的主要路径
                ray.dir = refractedDir;
                // 玻璃内部吸收很少，保持高吞吐量
                vec3 glassColor = mat.transmissionColor * mat.albedo;
                throughput *= glassColor * (1.0 - F) / max(1.0 - reflectionProbability, 0.1);
            }
        }
        // 处理金属材质（高反射）
        else if (mat.metallic > 0.8) {
            // 金属材质主要进行镜面反射
            vec3 reflectedDir = reflect(ray.dir, hitInfo.normal);
            
            // 根据粗糙度添加随机性
            if (mat.roughness > 0.0) {
                reflectedDir = normalize(mix(reflectedDir, RandomDirectionInHemisphere(hitInfo.normal, state), mat.roughness));
            }
            
            ray.dir = reflectedDir;
            throughput *= F * mat.albedo;
        }
        // 处理电介质材质（混合漫反射和镜面反射）
        else {
            // 根据菲涅尔项决定反射和漫反射的比例
            float reflectionProbability = (F.r + F.g + F.b) / 3.0;
            
            if (Rand(state) < reflectionProbability) {
                // 镜面反射
                vec3 reflectedDir = reflect(ray.dir, hitInfo.normal);
                
                // 根据粗糙度添加随机性
                if (mat.roughness > 0.0) {
                    reflectedDir = normalize(mix(reflectedDir, RandomDirectionInHemisphere(hitInfo.normal, state), mat.roughness));
                }
                
                ray.dir = reflectedDir;
                throughput *= F / reflectionProbability;
            } else {
                // 漫反射
                ray.dir = RandomDirectionInHemisphere(hitInfo.normal, state);
                
                // 能量守恒：漫反射部分 = (1 - F) * 漫反射颜色
                vec3 kD = (1.0 - F) * (1.0 - mat.metallic);
                throughput *= kD * mat.albedo / (1.0 - reflectionProbability);
            }
        }

        ray.origin = hitInfo.hitPoint + hitInfo.normal * 0.001;
    }

    return result_brightness_score;
}

void main(){
    // ----------------------------
    // 0. Initialization
    // 地面 - 粗糙塑料材质
    spheres[0].radius = 8.0f;
    spheres[0].position = vec3(0, -8, 0);
    spheres[0].material.albedo = vec3(0.8, 0.8, 0.8);  // 浅灰色
    spheres[0].material.metallic = 0.0;                // 非金属
    spheres[0].material.roughness = 0.9;               // 高粗糙度，漫反射为主
    spheres[0].material.alpha = 1.0;                   // 不透明
    spheres[0].material.emissionStrength = 0.0f;       // 不自发光
    spheres[0].material.emissionColor = vec3(0.0);
    spheres[0].material.reflectance = 0.04;            // 塑料的基础反射率
    spheres[0].material.specular = 0.5;
    spheres[0].material.ior = 1.45;                    // 塑料的折射率
    spheres[0].material.transmission = 0.0;            // 不透光
    spheres[0].material.transmissionColor = vec3(1.0);

    // 玻璃球体 - 透明玻璃材质
    spheres[1].radius = 0.75f;
    spheres[1].position = vec3(0, 0, -1);
    spheres[1].material.albedo = vec3(1.0, 1.0, 1.0);  // 白色
    spheres[1].material.metallic = 0.0;                // 非金属
    spheres[1].material.roughness = 0.05;              // 非常光滑
    spheres[1].material.alpha = 0.1;                   // 透明
    spheres[1].material.emissionStrength = 0.0f;       // 不自发光
    spheres[1].material.emissionColor = vec3(0.0);
    spheres[1].material.reflectance = 0.05;
    spheres[1].material.specular = 1.0;
    spheres[1].material.ior = 1.5;                     // 玻璃的折射率
    spheres[1].material.transmission = 0.9;            // 高透射率
    spheres[1].material.transmissionColor = vec3(0.95, 1.0, 0.98); // 略带蓝色的透射

    // 金属球体 - 黄金材质
    spheres[2].radius = 0.35f;
    spheres[2].position = vec3(-0.95, 0.2, -1.75);
    spheres[2].material.albedo = vec3(1.0, 0.86, 0.35); // 金色
    spheres[2].material.metallic = 1.0;                 // 纯金属
    spheres[2].material.roughness = 0.1;                // 较光滑的表面
    spheres[2].material.alpha = 1.0;                    // 不透明
    spheres[2].material.emissionStrength = 0.0f;        // 不自发光
    spheres[2].material.emissionColor = vec3(0.0);
    spheres[2].material.reflectance = 1.0;
    spheres[2].material.specular = 1.0;
    spheres[2].material.ior = 0.47;                     // 黄金的复杂IOR，这里简化
    spheres[2].material.transmission = 0.0;             // 金属不透明
    spheres[2].material.transmissionColor = vec3(1.0);

    // 电介质球体 - 红色塑料/陶瓷
    spheres[3].radius = 0.35f;
    spheres[3].position = vec3(0.5, 0.6, -1.8);
    spheres[3].material.albedo = vec3(0.8, 0.2, 0.2);  // 红色
    spheres[3].material.metallic = 0.0;                 // 非金属
    spheres[3].material.roughness = 0.3;                // 中等粗糙度
    spheres[3].material.alpha = 1.0;                    // 不透明
    spheres[3].material.emissionStrength = 0.0f;        // 不自发光
    spheres[3].material.emissionColor = vec3(0.0);
    spheres[3].material.reflectance = 0.04;
    spheres[3].material.specular = 0.5;
    spheres[3].material.ior = 1.45;                     // 塑料折射率
    spheres[3].material.transmission = 0.0;             // 不透光
    spheres[3].material.transmissionColor = vec3(1.0);

    // 可以添加第五个球体作为光源
    spheres[4].radius = 1.15f;
    spheres[4].position = vec3(0, 3, -1);
    spheres[4].material.albedo = vec3(1.0);
    spheres[4].material.metallic = 0.0;
    spheres[4].material.roughness = 1.0;
    spheres[4].material.alpha = 1.0;
    spheres[4].material.emissionStrength = 5.0f;        // 强发光
    spheres[4].material.emissionColor = vec3(1.0, 0.9, 0.7); // 暖白色光
    spheres[4].material.reflectance = 0.04;
    spheres[4].material.specular = 0.0;
    spheres[4].material.ior = 1.0;
    spheres[4].material.transmission = 0.0;
    spheres[4].material.transmissionColor = vec3(1.0);
    
    // ----------------------------
    // 1. Pixel cord conver to NDC(0..1)
    //vec2 screenSize = vec2(800.0, 800.0);
    //vec2 uv = gl_FragCoord.xy / screenSize;
    ivec2 gridSize = ivec2(gl_NumWorkGroups.xy * gl_WorkGroupSize.xy);
    //vec2 normalizedCoord = vec2(gl_GlobalInvocationID.xy) / vec2(gridSize);
    vec2 uv = vec2(gl_GlobalInvocationID.xy) / vec2(gridSize);

    // ----------------------------
    // 2. Convert to NDC [-1, 1]
    float x_ndc = uv.x * 2.0 - 1.0;
    float y_ndc = uv.y * 2.0 - 1.0;

    // ----------------------------
    // 3. Project to camera space
    vec3 dir_cam = normalize(vec3(
        x_ndc * globalUBO.aspect * globalUBO.tanHalfFovY,
        y_ndc * globalUBO.tanHalfFovY,
        1.0 //!not -1, because we want camera to look positive z direction
    ));
    //dir_cam = normalize(vec3(0,0,1.0));//!!!

    // ----------------------------
    // 4. Convert to world space
    Ray ray;
    vec4 clip_coord = vec4(x_ndc, y_ndc, -1.0, 1.0);
    vec4 view_coord = globalUBO.mainCameraProjInverse * clip_coord;
    //view_coord = clip_coord;//!!!
    view_coord = vec4(view_coord.xy, -1.0, 0.0);
    vec4 world_coord = globalUBO.mainCameraViewInverse * view_coord;
    //world_coord = view_coord;//!!!
    ray.dir = normalize(world_coord.xyz);
    ray.origin = globalUBO.mainCameraPos;
    //ray.origin = vec3(0,0,1);//!!!
    
    // ----------------------------
    // 5. Current Frame Color
    //uint state = gl_GlobalInvocationID.x ^ gl_GlobalInvocationID.y ^ customUBO.frameCount;
    uint state = gl_GlobalInvocationID.x;
    state = state * 747796405u + gl_GlobalInvocationID.y;
    state = state * 747796405u + customUBO.frameCount;
    state = state * 747796405u + 2891336453u;
    
    vec3 birghtness_score_sum = vec3(0.0);
    for(int i = 0; i < RAY_PER_PIXEL; i++)
        birghtness_score_sum += TraceRay(ray, state);

    vec3 currentFrameColor = birghtness_score_sum / RAY_PER_PIXEL;

    // ----------------------------
    // 6. Accumulate
    uint index = gl_GlobalInvocationID.y * gridSize.x + gl_GlobalInvocationID.x;

    //sboOut.pixels[index] = vec4(currentFrameColor, 1.0);
    //pixelsOut[index] = (vec4(finalColor, 1.0) + pixelsOut[index]) / 2.0f;
    //float coff = 0.75f;
    //sboOut.pixels[index] = (vec4(currentFrameColor, 1.0)*coff + sboIn.pixels[index]*coff );
    float alpha = 0.1;
    sboOut.pixels[index] = vec4(currentFrameColor, 1.0) * alpha + 
                        sboIn.pixels[index] * (1.0 - alpha);


    
    imageStore( resultImage, ivec2(gl_GlobalInvocationID.xy), sboOut.pixels[index]);
    //imageStore( resultImage, ivec2(gl_GlobalInvocationID.xy), vec4(currentFrameColor, 1.0)); //no accumulate
}