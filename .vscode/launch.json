{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [""],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "${workspaceFolder}/build/bin",
      "program": "${workspaceFolder}/build/bin/SimpleShadowMap2Shadows.exe",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}